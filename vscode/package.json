{
  "name": "qnx-buildfile",
  "displayName": "QNX Buildfile (ifslint)",
  "description": "Syntax highlighting, live linting and an image tree view for QNX mkifs buildfiles (QNX SDP 8.0).",
  "version": "0.1.0",
  "publisher": "vakoya",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/mura0420/ifslint" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["qnx", "mkifs", "buildfile", "embedded"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [{
      "id": "qnx-buildfile",
      "aliases": ["QNX Buildfile", "mkifs buildfile"],
      "extensions": [".build", ".bld"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{ "language": "qnx-buildfile", "scopeName": "source.qnx-buildfile", "path": "./syntaxes/qnx-buildfile.tmLanguage.json" }],
    "commands": [{ "command": "ifslint.showTree", "title": "QNX Buildfile: Show image tree" }]
  }
}
